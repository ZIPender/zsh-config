{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
      "right": 4
    },
    "color": {
      "1": "#A970FF",
      "2": "#70CFE3"
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "title": "#D89AFF"
    },
    "key": {
      "width": 12
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "OS",
      "keyColor": "#D89AFF"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "#C47CFF"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#A970FF"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#9277D8"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "#7F8FE8"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#70A8EE"
    },

    "break",

    {
      "type": "display",
      "key": "Display",
      "keyColor": "#70CFE3"
    },
    {
      "type": "de",
      "key": "Desktop",
      "keyColor": "#78BCEB"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#879FF4"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#9A86F9"
    },
    {
      "type": "terminalfont",
      "key": "Font",
      "keyColor": "#B275FA"
    },

    "break",

    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#D89AFF"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#C07FFF"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#A970FF"
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyColor": "#8E86F6"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#70A8EE"
    },

    "break",

    {
      "type": "localip",
      "key": "Local IP",
      "keyColor": "#70CFE3"
    },
    {
      "type": "locale",
      "key": "Locale",
      "keyColor": "#918799"
    }
  ]
}