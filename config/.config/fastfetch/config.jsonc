{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logos/albedo-current-logo.png",
    "width": 32,
    "height": 15,
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "title": "#D89AFF",
      "keys": "#A970FF"
    },
    "key": {
      "width": 10
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "OS",
      "keyColor": "#D89AFF"
    },

    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#BD63FF"
    },

    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#A970FF"
    },

    {
      "type": "display",
      "key": "Display",
      "keyColor": "#70CFE3"
    },

    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#8FAAFF"
    },

    "break",

    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#D89AFF"
    },

    {
      "type": "command",
      "key": "GPU",
      "keyColor": "#BD63FF",
      "text": "nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n1 | grep . || lspci 2>/dev/null | grep -E 'VGA|3D' | head -n1 | cut -d: -f3- | cut -c2-"
    },

    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#A970FF"
    },

    {
      "type": "swap",
      "key": "Swap",
      "keyColor": "#8FAAFF"
    },

    {
      "type": "localip",
      "key": "IP",
      "keyColor": "#70CFE3"
    }
  ]
}